# Copiar como .env y cambiar los valores marcados.
# En el servidor vive en /opt/hris/.env y nunca se sube al repositorio.
# En el despliegue de prueba del pipeline (sin servidor SSH) los valores "change-me" se reemplazan
# por secretos aleatorios generados con openssl.

# --- PostgreSQL (los lee la imagen oficial de postgres) ---
POSTGRES_USER=hris
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=hris

# --- API ---
# Debe coincidir con las credenciales de arriba; "db" es el nombre del servicio en docker compose
DATABASE_URL=postgres://hris:change-me-db-password@db:5432/hris
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h
NODE_ENV=production
PORT=3000
# Orígenes permitidos por CORS (frontend de Vite), separados por comas
CORS_ORIGIN=http://localhost:5173

# --- Despliegue con deploy/docker-compose.yml (no lo usa la API) ---
# Imagen publicada por el pipeline, con el owner del repositorio en minúsculas
HRIS_IMAGE=ghcr.io/owner/hris-backend
